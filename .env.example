# Copy this file to ".env" (which git ignores) and fill in what you need.
# These are only used while developing; in the finished app keys are entered
# on the Connect screen and stored encrypted by Windows.

# Your Anthropic (Claude) API key, used by the "Claude" preset if no key was saved in the app.
ANTHROPIC_API_KEY=

# Optional: OpenRouter key, used by the "OpenRouter" preset if no key was saved in the app.
OPENROUTER_API_KEY=
